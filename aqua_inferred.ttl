                                                                                                                                              ]
                                                                                                                                   ]
                                                                                      ] ;
                                                                            rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                                       rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#classPredicate> <http://www.w3.org/ns/sosa/Observation> ;
                                                                                                   <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/ducanh/ontologies/2026/2/untitled-ontology-2/obs>
                                                                                                 ] ;
                                                                                       rdf:rest rdf:nil
                                                                                     ]
                                                                          ]
                                                               ]
                                                    ]
                                         ] ;
   <http://www.w3.org/2003/11/swrl#head> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasRiskFactor ;
                                                       <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/ducanh/ontologies/2026/2/untitled-ontology-2/obs> ;
                                                       <http://www.w3.org/2003/11/swrl#argument2> :LowDO
                                                     ] ;
                                           rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                      rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                  <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasRiskLevel ;
                                                                  <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/ducanh/ontologies/2026/2/untitled-ontology-2/obs> ;
                                                                  <http://www.w3.org/2003/11/swrl#argument2> :High
                                                                ] ;
                                                      rdf:rest [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                                                 rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#IndividualPropertyAtom> ;
                                                                             <http://www.w3.org/2003/11/swrl#propertyPredicate> :hasRiskFactor ;
                                                                             <http://www.w3.org/2003/11/swrl#argument1> <http://www.semanticweb.org/ducanh/ontologies/2026/2/untitled-ontology-2/obs> ;
                                                                             <http://www.w3.org/2003/11/swrl#argument2> :HighTemp
                                                                           ] ;
                                                                 rdf:rest rdf:nil
                                                               ]
                                                    ]
                                         ]
 ] .

[ <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> "true"^^xsd:boolean ;
   rdfs:comment "" ;
   rdfs:label "Rule_LowRisk_LowTurbidity" ;
   rdf:type <http://www.w3.org/2003/11/swrl#Imp> ;
   <http://www.w3.org/2003/11/swrl#body> [ rdf:type <http://www.w3.org/2003/11/swrl#AtomList> ;
                                           rdf:first [ rdf:type <http://www.w3.org/2003/11/swrl#ClassAtom> ;
                                                       <http://www.w3.org/2003/11/swrl#classPredicate> <http://www.w3.org/ns/sosa/Observation> ;
