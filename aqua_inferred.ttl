###  http://www.ntu.edu.vn/ontology/aqua-risk#hasCorrectiveInterventions
:hasCorrectiveInterventions rdf:type owl:DatatypeProperty ;
                            rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                            rdfs:range xsd:integer .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasDO
:hasDO rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain <http://www.w3.org/ns/sosa/Observation> .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasDataConfidenceScore
:hasDataConfidenceScore rdf:type owl:DatatypeProperty .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasDiseaseOccurrence
:hasDiseaseOccurrence rdf:type owl:DatatypeProperty ;
                      rdfs:domain :DiseaseEvent .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasOxygenationInterventions
:hasOxygenationInterventions rdf:type owl:DatatypeProperty ;
                             rdfs:domain <http://www.w3.org/ns/sosa/Observation> ;
                             rdfs:range xsd:integer .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasPH
:hasPH rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain <http://www.w3.org/ns/sosa/Observation> .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasSHACL_ViolationCount
:hasSHACL_ViolationCount rdf:type owl:DatatypeProperty .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasTemp
:hasTemp rdf:type owl:DatatypeProperty ;
         rdfs:subPropertyOf owl:topDataProperty ;
         rdfs:domain <http://www.w3.org/ns/sosa/Observation> .


###  http://www.ntu.edu.vn/ontology/aqua-risk#hasTurbidity
:hasTurbidity rdf:type owl:DatatypeProperty ;
              rdfs:domain <http://www.w3.org/ns/sosa/Observation> .


###  http://www.ntu.edu.vn/ontology/aqua-risk#observedAtTime
:observedAtTime rdf:type owl:DatatypeProperty ;
                rdfs:domain :Pond ,
                            <http://www.w3.org/ns/sosa/Observation> .


###  http://www.w3.org/ns/sosa/resultTime
<http://www.w3.org/ns/sosa/resultTime> rdf:type owl:DatatypeProperty ;
                                       rdfs:range xsd:dateTime ;
                                       <http://schema.org/domainIncludes> <http://www.w3.org/ns/sosa/Actuation> ,
                                                                          <http://www.w3.org/ns/sosa/Observation> ,
                                                                          <http://www.w3.org/ns/sosa/Sampling> ;
                                       rdfs:comment "The result time is the instant of time when the Observation, Actuation or Sampling activity was completed."@en ;
                                       rdfs:isDefinedBy <http://www.w3.org/ns/sosa/> ;
                                       rdfs:label "result time"@en ;
                                       <http://www.w3.org/2004/02/skos/core#definition> "The result time is the instant of time when the Observation, Actuation or Sampling activity was completed."@en .


